# Copy this file to backend/.env for local development. Never commit .env.

# development = login cookies work on http://localhost and login codes print in the terminal.
# Never set this on Render.
FLASK_ENV=development

# Your MongoDB Atlas connection string (same cluster as production is fine)...
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
# ...but a SEPARATE database name, so local tests never touch real students.
MONGO_DB_NAME=study_partner_dev

# Optional locally (a temporary key is used in development). REQUIRED on Render.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional locally. Without these, login codes are only printed in the terminal.
MAIL_USERNAME=
MAIL_PASSWORD=

# Emails allowed to run the NTHU course refresh (comma-separated).
ADMIN_EMAILS=

# Optional: override the allowed frontend origins (comma-separated).
# ALLOWED_ORIGINS=http://localhost:3000
